@startuml
' Activity Diagram
start
:接收需求与参数输入;
:初始化上下文 (AgentState);

if (任务类型?) then (design)
  :自动生成设计模型;
  :保存类图/活动图/说明;
  stop
elseif (code)
  :调用大模型生成代码与测试;
  :保存源码与测试文件;
  :执行单元测试;
  while (测试未通过 且 未达重试上限?) is (是)
    :根据错误日志修复代码;
    :重新执行测试;
  endwhile (否)
  stop
elseif (fix)
  :读取本地已有代码与测试;
  :执行初次单元测试;
  while (测试未通过 且 未达重试上限?) is (是)
    :根据错误日志修复代码;
    :重新执行测试;
  endwhile (否)
  stop
else (full)
  :自动生成设计模型;
  :保存类图/活动图/说明;
  :将设计上下文注入需求;
  :调用大模型生成代码与测试;
  :保存源码与测试文件;
  :执行单元测试;
  while (测试未通过 且 未达重试上限?) is (是)
    :根据错误日志修复代码;
    :重新执行测试;
  endwhile (否)
  stop
endif
@enduml
