{
  "name": "agent-ui",
  "displayName": "agent-ui",
  "description": "AI Intelligent Agent Plugin with Chat Interface",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.117.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-ui-sidebar",
          "title": "Agent UI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agent-ui-sidebar": [
        {
          "type": "webview",
          "id": "agent-ui.chatView",
          "name": "智能助手"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-ui.generateCode",
        "title": "Agent UI: 生成代码"
      }
    ],
    "keybindings": [
      {
        "command": "agent-ui.generateCode",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agent-ui.generateCode",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Agent UI",
      "properties": {
        "agent-ui.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Agent backend base URL"
        },
        "agent-ui.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Request timeout in milliseconds"
        },
        "agent-ui.streaming": {
          "type": "boolean",
          "default": true,
          "description": "Enable streaming output"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}